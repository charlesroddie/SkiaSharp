<Project Sdk="MSBuild.Sdk.Extras/3.0.44">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SkiaSharp.Views.UWP</RootNamespace>
    <AssemblyName>SkiaSharp.Views.UWP</AssemblyName>
    <PackagingGroup>SkiaSharp.Views</PackagingGroup>
    <PackagingPlatform>uap10.0</PackagingPlatform>
    <UseUwp>true</UseUwp>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Disable default compile items to avoid duplicates -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.3233" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\binding\SkiaSharp\SkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SkiaSharp.Views.Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Local UWP-specific file -->
    <Compile Include="SKXamlCanvas.cs" />
    <!-- TODO: Create UWP-specific versions of these files -->
    <!-- <Compile Include="SKSwapChainPanel.cs" /> -->
    <!-- <Compile Include="UWPExtensions.cs" /> -->
    <!-- <Compile Include="AngleSwapChainPanel.cs" /> -->
    <!-- <Compile Include="GlesInterop\Egl.cs" /> -->
    <!-- <Compile Include="GlesInterop\GlesContext.cs" /> -->
  </ItemGroup>
</Project>